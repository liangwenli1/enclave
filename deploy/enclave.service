# INTERNAL Linux verification host only.
# Not a customer deliverable. See docs/enclave-final-delivery.md.

[Unit]
Description=Enclave Linux verification workbench (NOT 1.0)
After=network.target

[Service]
Type=simple
User=enclave
WorkingDirectory=/home/enclave/enclave
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run dev
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
