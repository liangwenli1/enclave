[Unit]
Description=Enclave browser workbench
After=network.target

[Service]
Type=simple
User=enclave
WorkingDirectory=/home/enclave/enclave
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run dev
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# Chromium in the same cgroup as the workbench
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
