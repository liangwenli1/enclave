{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enclave",
  "version": "0.10.0",
  "identifier": "com.enclave.workbench",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "",
    "frontendDist": "../../../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://127.0.0.1:17891; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": { "../../../kernels.manifest.json": "kernels.manifest.json" },
    "externalBin": ["binaries/enclave-host"],
    "windows": {
      "digestAlgorithm": "sha256"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["enclave"] }
    }
  }
}
